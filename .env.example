# Variables de entorno del proyecto.
#
# Copia este archivo como ".env" y rellena los valores, o exporta las variables
# en tu shell. El archivo ".env" esta en .gitignore: NO lo subas nunca.
#
# Ninguna credencial debe aparecer en este archivo: aqui solo van los NOMBRES.
# La aplicacion no lee ".env" automaticamente (no se usa python-dotenv); para
# cargarlo en local:
#
#   Linux/macOS:  set -a; . ./.env; set +a
#   PowerShell:   Get-Content .env | ForEach-Object {
#                   if ($_ -match '^([^#][^=]*)=(.*)$') {
#                     [Environment]::SetEnvironmentVariable($matches[1], $matches[2])
#                   }
#                 }

# ---------------------------------------------------------------------------
# OBLIGATORIA
# ---------------------------------------------------------------------------

# Clave de la API de OMDb. Sin ella la aplicacion no arranca.
# Se consigue gratis en https://www.omdbapi.com/ (plan "Free").
OMDB_API_KEY=

# ---------------------------------------------------------------------------
# OPCIONAL: valores por defecto en ()
# ---------------------------------------------------------------------------

# Segundos de espera por peticion HTTP. Rango admitido: 1-120. (10.0)
OMDB_TIMEOUT=

# Reintentos de requests ante errores de transporte. (3)
OMDB_MAX_RETRIES=

# Caducidad de las entradas de cache, en segundos. (3600)
CACHE_TTL_SECONDS=

# Maximo de entradas por cache; al superarlo se expulsa la menos usada. (256)
CACHE_MAX_ENTRIES=

# Maximo de entradas del historial de busquedas. (100)
MAX_HISTORY_ENTRIES=

# Activa el log a nivel DEBUG (incluye URLs y parametros enmascarados). (false)
APP_DEBUG=

# Activa el log a nivel INFO (operaciones normales: pelicula encontrada, etc). (false)
APP_VERBOSE=

# ---------------------------------------------------------------------------
# Variables que este proyecto NO usa
# ---------------------------------------------------------------------------
# Se listan aqui para evitar que se configuren por error: TVMaze es una API
# publica que no requiere clave, y el proyecto no usa base de datos.
#
#   TVMAZE_API_KEY=      <- no se usa
#   DB_HOST=             <- no se usa
#   DB_NAME=             <- no se usa
#   DB_USER=             <- no se usa
#   DB_PASSWORD=         <- no se usa